<% layout("layouts/boilerplate") %>
  <h2 class="portfolio-color mt-5 pt-5 index text-center"><b>Skills</b></h2>
  <div class="container skills-section py-5 text-center">
    <div class="row g-2">
      <% for (let lists of listingsOfData) { %>
        <% for (let skill of lists.skills) { %>
          <div class="col-md-3">
            <div class="card bg-dark text-white shadow-sm h-100">
              <div class="card-body">
                <i class="bi bi-code-slash fs-1 text-primary"></i>
                <h5 class="mt-2">
                  <%= skill %>
                </h5>
              </div>
            </div>
          </div>
          <% } %>
            <% } %>
    </div>
  </div>