<% layout("layouts/boilerplate") %>

<div class="container hide-bg skills-section py-5 text-center index">
    <h2 class="portfolio-color mt-5 mb-5 display-4"><b>My Tech Stack</b></h2>
    
    <div class="row g-4 justify-content-center">
        <% if (typeof listingsOfData !== 'undefined' && listingsOfData.length > 0) { %>
            <% for (let lists of listingsOfData) { %>
                <% for (let skill of lists.skills) { %>
                    <div class="col-6 col-md-3 col-lg-2">
                        <div class="skill-card p-4 shadow-lg">
                            <div class="icon-box mb-3">
                                <i class="fa-solid fa-code-terminal fs-1 pink-text"></i>
                            </div>
                            <h5 class="skill-name fw-bold">
                                <%= skill %>
                            </h5>
                            <div class="skill-progress mt-2"></div>
                        </div>
                    </div>
                <% } %>
            <% } %>
        <% } %>
    </div>
</div>