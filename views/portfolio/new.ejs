<% layout("layouts/boilerplate") %>

<div class="container hide-bg py-5 mt-5">
  <div class="row justify-content-center">
    <div class="col-lg-7 col-md-9">
      
      <div class="form-glass-container p-4 p-md-5 shadow-lg">
        
        <div class="text-center mb-5">
          <h2 class="portfolio-color display-6 fw-bold mb-2">Build New Project</h2>
          <p class="text-secondary small text-uppercase tracking-widest">Add a new milestone to your portfolio</p>
          <div class="underline-pink mx-auto"></div>
        </div>

        <form action="/projects" method="POST" class="needs-validation" novalidate>
          
          <div class="mb-4">
            <label for="title" class="form-label text-secondary fw-semibold">Project Title</label>
            <div class="input-group">
              <span class="input-group-text bg-transparent border-end-0 border-secondary"><i class="fa-solid fa-rocket pink-text"></i></span>
              <input 
                type="text" 
                id="title" 
                name="listing[title]" 
                class="form-control premium-input border-start-0"
                placeholder="e.g. Wanderlust App"
                required
              >
            </div>
            <div class="invalid-feedback text-danger small">Project ka ek cool sa naam rakho!</div>
          </div>

          <div class="mb-4">
            <label for="techStack" class="form-label text-secondary fw-semibold">Tech Stack (comma separated)</label>
            <div class="input-group">
              <span class="input-group-text bg-transparent border-end-0 border-secondary"><i class="fa-solid fa-layer-group pink-text"></i></span>
              <input 
                type="text" 
                id="techStack" 
                name="listing[techStack]" 
                class="form-control premium-input border-start-0"
                placeholder="e.g. MongoDB, Express, React, Node"
                required
              >
            </div>
            <div class="invalid-feedback text-danger small">Skills toh mention karni padengi.</div>
          </div>

          <div class="mb-4">
            <label for="image" class="form-label text-secondary fw-semibold">Live Project / GitHub URL</label>
            <div class="input-group">
              <span class="input-group-text bg-transparent border-end-0 border-secondary"><i class="fa-solid fa-globe pink-text"></i></span>
              <input 
                type="text" 
                id="image" 
                name="listing[image]" 
                class="form-control premium-input border-start-0"
                placeholder="https://my-cool-project.com"
                required
              >
            </div>
          </div>

          <div class="mb-4">
            <label for="description" class="form-label text-secondary fw-semibold">Brief Description</label>
            <textarea 
              id="description" 
              name="listing[description]" 
              rows="4"
              class="form-control premium-input" 
              placeholder="Explain what this project does and how you built it..."
              required
            ></textarea>
            <div class="invalid-feedback text-danger small">Description ke bina recruiters ko samajh nahi aayega.</div>
          </div>

          <div class="d-grid mt-5">
            <button type="submit" class="btn btn-create-neon py-3">
              <i class="fa-solid fa-plus-circle me-2"></i> Launch Project
            </button>
            <a href="/projects" class="btn btn-link text-secondary mt-3 text-decoration-none small">
               Go Back to Projects
            </a>
          </div>

        </form>
      </div>
    </div>
  </div>
</div>