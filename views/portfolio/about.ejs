    <div class="col-md-6">
      <h3 class="text-white mb-4"><i class="fa-solid fa-graduation-cap pink-text me-2"></i>Education</h3>
      <div class="crazy-card p-4 h-100">
        <h4 class="text-white mb-1">Bachelors of Technology</h4>
        <p class="pink-text mb-2">Computer Science & Engineering</p>
        <p class="mb-1 text-secondary"><i class="fa-solid fa-university me-2"></i>Sarala Birla University, Ranchi</p>
        <p class="mb-0 text-secondary"><i class="fa-solid fa-calendar-day me-2"></i>2023 - 2027</p>
      </div>
    </div>
